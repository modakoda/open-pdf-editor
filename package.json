{
  "name": "open-pdf-editor",
  "productName": "Open PDF Editor",
  "desktopName": "open-pdf-editor.desktop",
  "version": "0.1.0",
  "description": "Cross-platform desktop PDF editor for Windows, macOS and Linux",
  "license": "MIT",
  "author": "Modestas Kažinauskas",
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "dependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.11.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/lit": "^1.0.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.62.0",
    "node-forge": "^1.4.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-ocr-assets.mjs",
    "predev": "npm run assets",
    "dev": "electron-vite dev",
    "prebuild": "npm run assets",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "vitest run --project core",
    "test:renderer": "vitest run --project renderer",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "predev:web": "npm run assets",
    "dev:web": "vite --config vite.web.config.ts",
    "fixtures": "node tests/fixtures/generate.ts",
    "icon": "electron build/generate-icon.mjs",
    "pack": "npm run build && electron-builder --dir",
    "test:e2e:ui": "npm run build && playwright test -g \"editor UI\""
  }
}
