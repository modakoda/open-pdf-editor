{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "@testing-library/jest-dom/vitest"]
  },
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/env.d.ts",
    "src/preload/*.d.ts",
    "src/shared/**/*",
    "src/core/**/*",
    "tests/renderer/**/*"
  ]
}
