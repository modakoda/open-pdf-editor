{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "electron.vite.config.ts",
    "vite.web.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/core/**/*",
    "tests/core/**/*",
    "tests/e2e/**/*",
    "tests/fixtures/**/*.ts",
    "scripts/**/*.ts"
  ]
}
